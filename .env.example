# ==============================================================================
# NEURO-SYMBOLIC HARNESS (ADK) - Konfiguracja Połączenia LLM
# Skopiuj ten plik jako .env i uzupełnij wybrany klucz / ustawienia
# ==============================================================================

# Wybór dostawcy: "auto" | "google" | "ollama" | "mock"
# "auto" wybierze Google Gemini jeśli GEMINI_API_KEY jest ustawiony, wpp. Ollama
HARNESS_PROVIDER=auto

# --- Opcja 1: Google Gemini API ---
GEMINI_API_KEY=
HARNESS_GOOGLE_SML_MODEL=gemini-2.5-flash
HARNESS_GOOGLE_LRM_MODEL=gemini-2.5-pro

# --- Opcja 2: Lokalna Ollama ---
OLLAMA_URL=http://localhost:11434/api/generate
HARNESS_OLLAMA_SML_MODEL=gemma4:e2b
HARNESS_OLLAMA_LRM_MODEL=qwen3-coder:latest

# --- Logowanie procesu ---
HARNESS_LOG_DIR=adk/logs
HARNESS_VERBOSE_CONSOLE=1

