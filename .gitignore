# ==============================================================================
# Artificial-Degree-Printer (ADK 2027) - Comprehensive .gitignore
# ==============================================================================

# --- Python Environment & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# --- Testing & Code Quality ---
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/
.nox/
htmlcov/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# --- Environment Variables, API Keys & Secrets ---
.env
.env.local
.env.*.local
*.env
*.pem
*.key
secrets.json

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- LaTeX Auxiliary Build Artifacts ---
# (Maintains final .tex, .bib, and .typ, but ignores transient compiler outputs)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb
*.bcf
*.run.xml

# --- Ephemeral Runtime Logs & Caches ---
adk/logs/run-*.json
!adk/logs/.gitkeep

# --- Generated Code and Project Workspaces ---
projects/
generated_project/

