{
  "name": "adk-viewer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun nuxt dev",
    "build": "bunx --bun nuxt build",
    "preview": "bunx --bun nuxt preview",
    "snapshot": "bun scripts/snapshot.ts",
    "generate:deployed": "NUXT_PUBLIC_DEPLOYED=true bunx --bun nuxt generate && bun -e \"require('node:fs').cpSync('.snapshot', '.output/public/snapshot', { recursive: true })\"",
    "deploy": "bun run snapshot && bun run generate:deployed && bun scripts/deploy.ts",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "bun test",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o .storybook-out"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "cytoscape": "3.34.4",
    "echarts": "6.1.0",
    "markdown-it": "14.3.3",
    "nuxt": "4.6.4",
    "vue-echarts": "8.3.2",
    "vuetify": "4.3.2",
    "vuetify-nuxt-module": "0.19.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxtjs/storybook": "10.0.3",
    "@storybook/addon-docs": "10.6.5",
    "@types/bun": "1.3.14",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^22.20.5",
    "eslint": "10.14.0",
    "firebase-tools": "15.35.0",
    "storybook": "10.6.5",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.14"
  }
}
